From e8c421856cf21406c2ce0d72eb8f95394ad8ad6c Mon Sep 17 00:00:00 2001
From: imranf45 <imranf45@gmail.com>
Date: Sun, 6 Jul 2025 15:07:00 +0100
Subject: [PATCH] Build gem5 with mqsim library

---
 src/SConscript     | 8 ++++++++
 src/sim/SConscript | 4 ++++
 src/sim/main.cc    | 3 ++-
 3 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/SConscript b/src/SConscript
index 6e8d8cd67b..78706f9fcc 100644
--- a/src/SConscript
+++ b/src/SConscript
@@ -64,6 +64,8 @@ if env['CONF']['USE_EFENCE']:
 # Children need to see the environment
 Export('env')

+env.Append(CPPPATH=['#ext/mqsim/src/sim'])
+
 build_env = list(env['CONF'].items())

 from code_formatter import code_formatter
@@ -722,6 +724,12 @@ lib_filter = with_tag('gem5 lib')
 if GetOption('without_python'):
     lib_filter = lib_filter & without_tag('python')

+# Include mqsim library
+if os.path.isdir('ext/mqsim'):
+    SConscript('ext/mqsim/SConscript')
+
+
+
 StaticLib(lib_name, lib_filter)
 SharedLib(lib_name, lib_filter)

diff --git a/src/sim/SConscript b/src/sim/SConscript
index 0ae77347ca..ec8681f980 100644
--- a/src/sim/SConscript
+++ b/src/sim/SConscript
@@ -111,6 +111,10 @@ Source('stats.cc')
 Source('workload.cc')
 Source('mem_pool.cc')

+env.Append(CPPPATH=['#ext/mqsim'])
+env.Append(LIBPATH=['#ext/mqsim/build'])
+env.Append(LIBS=['mqsim'])
+
 env.TagImplies('gem5 drain', ['gem5 events', 'gem5 trace'])
 env.TagImplies('gem5 events', ['gem5 serialize', 'gem5 trace'])
 env.TagImplies('gem5 serialize', 'gem5 trace')
diff --git a/src/sim/main.cc b/src/sim/main.cc
index 1c42891816..b66f16ec0a 100644
--- a/src/sim/main.cc
+++ b/src/sim/main.cc
@@ -29,7 +29,7 @@
 #include <Python.h>

 #include <iostream>
-
+#include "test.h"
 #include "pybind11/embed.h"
 #include "pybind11/pybind11.h"

@@ -47,6 +47,7 @@ namespace py = pybind11;
 int
 main(int argc, char **argv)
 {
+    MQSim_Dummy_Link();
     // Initialize gem5 special signal handling.
     initSignals();

--
